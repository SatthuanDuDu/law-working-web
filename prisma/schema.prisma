generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  LAWYER
  SUPPORT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MatterStatus {
  NEW
  IN_PROGRESS
  ON_HOLD
  CLOSED
  ARCHIVED
}

enum MatterType {
  CIVIL
  CRIMINAL
  CORPORATE
  LABOR
  FAMILY
  OTHER
}

enum ClientBusinessType {
  LLC
  JSC
  SOLE_PROPRIETOR
  PARTNERSHIP
  INDIVIDUAL
  OTHER
}

/** Who may view a matter/plan document (shared across file versions). */
enum AttachmentAccessMode {
  ALL_MEMBERS
  ALLOWLIST
  DENYLIST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum MatterPlanStepStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE
  PLAN_ASSIGNED
  PLAN_DUE
  GENERAL
  MENTION
  CHAT_MESSAGE
  WALLET_BUDGET_PENDING
  WALLET_BUDGET_UPDATE
  WALLET_CLIENT_PENDING
  WALLET_CLIENT_UPDATE
}

enum MoneyConfirmationKind {
  BUDGET_ALLOCATE
  CLIENT_RECEIPT
}

enum MoneyConfirmationStatus {
  PENDING_RECIPIENT
  PENDING_ALLOCATOR
  CONFIRMED
  REJECTED
  DISPUTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum ConversationType {
  DIRECT
  GROUP
  ALL
}

enum ExpenseType {
  COURT_FEE
  NOTARY
  TRAVEL
  TRANSLATION
  DOCUMENT
  EXPERTISE
  OTHER
}

enum WalletDirection {
  CREDIT
  DEBIT
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id                     String               @id @default(cuid())
  username               String               @unique
  email                  String               @unique
  password               String
  name                   String
  phone                  String?
  dateOfBirth            DateTime?
  gender                 Gender?
  role                   Role                 @default(SUPPORT)
  departmentId           String?
  department             Department?          @relation(fields: [departmentId], references: [id])
  avatarKey              String?
  isActive               Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  assignedTasks          Task[]               @relation("AssignedTasks")
  createdTasks           Task[]               @relation("CreatedTasks")
  planStepAssignments    MatterPlanStepAssignee[]
  ledMatters             Matter[]             @relation("LeadLawyer")
  matterMembers          MatterMember[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  uploadedFiles          Attachment[]
  comments               Comment[]
  commentMentions        CommentMention[]
  conversationsCreated   Conversation[]       @relation("ConversationCreator")
  conversationMembers    ConversationMember[]
  chatMessages           ChatMessage[]
  chatMessageMentions    ChatMessageMention[]
  staffWallet             StaffWallet?
  walletTxCreated         WalletTransaction[] @relation("WalletTxCreatedBy")
  walletTxAllocated       WalletTransaction[] @relation("WalletTxAllocatedBy")
  moneyConfirmationsFrom  MoneyConfirmation[] @relation("MoneyConfirmFrom")
  moneyConfirmationsTo    MoneyConfirmation[] @relation("MoneyConfirmTo")
  attachmentAccessUpdates AttachmentAccess[]     @relation("AttachmentAccessUpdater")
  attachmentAccessEntries AttachmentAccessUser[]
  pushSubscriptions       PushSubscription[]
}

model Client {
  id           String              @id @default(cuid())
  code         String              @unique
  name         String
  email        String?
  phone        String?
  address      String?
  city         String?
  businessType ClientBusinessType?
  notes        String?
  deletedAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  matters      Matter[]
  attachments  Attachment[]

  @@index([deletedAt])
}

model Matter {
  id           String         @id @default(cuid())
  code         String         @unique
  title        String
  description  String?
  type            MatterType     @default(OTHER)
  customTypeLabel String?
  status          MatterStatus   @default(NEW)
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id])
  leadLawyerId String
  leadLawyer   User           @relation("LeadLawyer", fields: [leadLawyerId], references: [id])
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  members      MatterMember[]
  planSteps    MatterPlanStep[]
  tasks        Task[]
  attachments  Attachment[]
  folders      MatterFolder[]
  comments            Comment[]
  walletTransactions  WalletTransaction[]
  moneyConfirmations  MoneyConfirmation[]
  @@index([leadLawyerId])
  @@index([clientId])
  @@index([updatedAt])
  @@index([status])
  @@index([deletedAt])
}

model MatterFolder {
  id          String       @id @default(cuid())
  matterId    String
  matter      Matter       @relation(fields: [matterId], references: [id], onDelete: Cascade)
  name        String
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments Attachment[]

  @@unique([matterId, name])
  @@index([matterId])
}

/** Per-user imprest wallet; balance updated with each non-legacy ledger row. */
model StaffWallet {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceVnd BigInt   @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  transactions WalletTransaction[]
}

model WalletTransaction {
  id               String               @id @default(cuid())
  walletUserId     String
  wallet           StaffWallet          @relation(fields: [walletUserId], references: [userId], onDelete: Cascade)
  direction        WalletDirection
  amountVnd        BigInt
  balanceAfterVnd  BigInt
  spendCategoryId  String?
  spendCategory    SpendCategory?       @relation(fields: [spendCategoryId], references: [id], onDelete: SetNull)
  note             String?
  detail           String?
  allocatedById    String?
  allocatedBy      User?                @relation("WalletTxAllocatedBy", fields: [allocatedById], references: [id], onDelete: SetNull)
  createdById      String
  createdBy        User                 @relation("WalletTxCreatedBy", fields: [createdById], references: [id])
  matterId         String?
  matter           Matter?              @relation(fields: [matterId], references: [id], onDelete: SetNull)
  matterPlanStepId String?
  matterPlanStep   MatterPlanStep?      @relation(fields: [matterPlanStepId], references: [id], onDelete: SetNull)
  expenseType      ExpenseType?
  customTypeLabel  String?
  /** Legacy MatterExpense import: history only, does not change balance. */
  legacyImported   Boolean              @default(false)
  createdAt        DateTime             @default(now())
  attachments      Attachment[]
  moneyConfirmation MoneyConfirmation?

  @@index([walletUserId, createdAt])
  @@index([spendCategoryId, createdAt])
  @@index([matterId])
  @@index([direction, createdAt])
  @@index([legacyImported])
}

/** Dual-sided confirmation for budget allocate / client cash handoff. */
model MoneyConfirmation {
  id                   String                   @id @default(cuid())
  kind                 MoneyConfirmationKind
  status               MoneyConfirmationStatus  @default(PENDING_RECIPIENT)
  amountVnd            BigInt
  note                 String?
  disputeNote          String?
  fromUserId           String
  fromUser             User                     @relation("MoneyConfirmFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId             String
  toUser               User                     @relation("MoneyConfirmTo", fields: [toUserId], references: [id], onDelete: Cascade)
  matterId             String?
  matter               Matter?                  @relation(fields: [matterId], references: [id], onDelete: SetNull)
  matterPlanStepId     String?
  matterPlanStep       MatterPlanStep?          @relation(fields: [matterPlanStepId], references: [id], onDelete: SetNull)
  recipientRespondedAt DateTime?
  allocatorConfirmedAt DateTime?
  walletTransactionId  String?                  @unique
  walletTransaction    WalletTransaction?       @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([fromUserId, status])
  @@index([toUserId, status])
  @@index([kind, status])
  @@index([matterId])
}

/** Admin/Manager-managed spend groups (vụ việc, văn phòng phẩm, …). */
model SpendCategory {
  id             String              @id @default(cuid())
  name           String              @unique
  /** Stable key for seeded system rows: MATTER | OFFICE | OTHER */
  code           String?             @unique
  requiresMatter Boolean             @default(false)
  isSystem       Boolean             @default(false)
  isActive       Boolean             @default(true)
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  transactions   WalletTransaction[]

  @@index([isActive, sortOrder])
}

model MatterPlanStep {
  id               String                   @id @default(cuid())
  matterId         String
  matter           Matter                   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  title            String
  workTypeId       String?
  workType         WorkType?                @relation(fields: [workTypeId], references: [id], onDelete: SetNull)
  startedAt        DateTime?
  dueAt            DateTime?
  reminderSentAt   DateTime?
  status           MatterPlanStepStatus     @default(NOT_STARTED)
  priority         TaskPriority             @default(MEDIUM)
  statusChangedAt  DateTime?
  sortOrder        Int                      @default(0)
  locationName     String?
  locationAddress  String?
  locationPlaceId  String?
  locationLat      Float?
  locationLng      Float?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  comments         Comment[]
  attachments      Attachment[]
  assignees        MatterPlanStepAssignee[]
  walletTransactions WalletTransaction[]
  moneyConfirmations MoneyConfirmation[]

  @@index([matterId, sortOrder])
  @@index([dueAt])
  @@index([status, dueAt])
  @@index([startedAt])
}

model MatterPlanStepAssignee {
  id        String         @id @default(cuid())
  stepId    String
  userId    String
  step      MatterPlanStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([stepId, userId])
  @@index([userId])
}

model MatterMember {
  id        String   @id @default(cuid())
  matterId  String
  userId    String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([matterId, userId])
  @@index([userId])
}

model WorkType {
  id        String     @id @default(cuid())
  name      String     @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  planSteps MatterPlanStep[]
}

model AttachmentLabel {
  id          String       @id @default(cuid())
  name        String       @unique
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments Attachment[]
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  reminderSentAt DateTime?
  assigneeId     String
  assignee       User         @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdById    String
  createdBy      User         @relation("CreatedTasks", fields: [createdById], references: [id])
  matterId       String?
  matter         Matter?      @relation(fields: [matterId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  attachments    Attachment[]

  @@index([assigneeId])
  @@index([dueDate])
  @@index([status])
  @@index([matterId])
  @@index([assigneeId, status, dueDate])
}

model Attachment {
  id               String           @id @default(cuid())
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  matterId         String?
  matter           Matter?          @relation(fields: [matterId], references: [id], onDelete: Cascade)
  taskId           String?
  task             Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  clientId         String?
  client           Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  matterPlanStepId String?
  matterPlanStep   MatterPlanStep?  @relation(fields: [matterPlanStepId], references: [id], onDelete: Cascade)
  commentId        String?
  comment          Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  conversationId   String?
  conversation     Conversation?    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  chatMessageId    String?
  chatMessage      ChatMessage?     @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  walletTransactionId String?
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: Cascade)
  labelId          String?
  label            AttachmentLabel? @relation(fields: [labelId], references: [id], onDelete: SetNull)
  customLabel      String?
  folderId         String?
  folder           MatterFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  isImportant      Boolean          @default(false)
  /** Same value across replace versions of one logical file. */
  versionGroupId   String
  version          Int              @default(1)
  isLatest         Boolean          @default(true)
  uploadedById     String
  uploadedBy       User             @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime         @default(now())

  @@index([matterPlanStepId])
  @@index([commentId])
  @@index([conversationId])
  @@index([chatMessageId])
  @@index([walletTransactionId])
  @@index([labelId])
  @@index([folderId])
  @@index([isImportant])
  @@index([versionGroupId])
  @@index([matterId, isLatest])
}

/** Per logical file (versionGroupId): who may view matter/plan documents. */
model AttachmentAccess {
  versionGroupId String               @id
  mode           AttachmentAccessMode @default(ALL_MEMBERS)
  updatedAt      DateTime             @updatedAt
  updatedById    String?
  updatedBy      User?                @relation("AttachmentAccessUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  users          AttachmentAccessUser[]
}

model AttachmentAccessUser {
  id             String           @id @default(cuid())
  versionGroupId String
  access         AttachmentAccess @relation(fields: [versionGroupId], references: [versionGroupId], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@unique([versionGroupId, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

/** Browser Web Push subscription (one row per device/browser). */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Comment {
  id               String           @id @default(cuid())
  matterId         String
  matter           Matter           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  matterPlanStepId String?
  matterPlanStep   MatterPlanStep?  @relation(fields: [matterPlanStepId], references: [id], onDelete: Cascade)
  authorId         String
  author           User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body             String
  locationName     String?
  locationAddress  String?
  locationPlaceId  String?
  locationLat      Float?
  locationLng      Float?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  mentions         CommentMention[]
  attachments      Attachment[]

  @@index([matterId, createdAt])
  @@index([matterPlanStepId, createdAt])
}

model CommentMention {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

model Conversation {
  id          String               @id @default(cuid())
  type        ConversationType
  name        String?
  createdById String
  createdBy   User                 @relation("ConversationCreator", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     ConversationMember[]
  messages    ChatMessage[]
  attachments Attachment[]

  @@index([updatedAt])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id               String               @id @default(cuid())
  conversationId   String
  conversation     Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body             String               @default("")
  locationName     String?
  locationAddress  String?
  locationPlaceId  String?
  locationLat      Float?
  locationLng      Float?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  mentions         ChatMessageMention[]
  attachments      Attachment[]

  @@index([conversationId, createdAt])
}

model ChatMessageMention {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}
